{
  "folders": [
    {
      "name": ".github (Org Governance)",
      "path": ".",
    },
    {
      "name": "platform (Core Monorepo)",
      "path": "../platform",
    },
    {
      "name": "docs (Documentation Hub)",
      "path": "../docs",
    },
  ],
  "settings": {
    "git.autoRepositoryDetection": true,
    "files.exclude": {
      "**/.git": false,
    },
  },
  "extensions": {
    "recommendations": [
      "bradlc.vscode-tailwindcss",
      "d-koppenhagen.file-tree-to-text-generator",
      "dbaeumer.vscode-eslint",
      "emanuelebartolesi.taskdeck",
      "esbenp.prettier-vscode",
      "github.vscode-github-actions",
      "redhat.vscode-yaml",
      "shd101wyy.markdown-preview-enhanced",
      "unifiedjs.vscode-mdx",
    ],
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Antigravity CLI (Organization Scope)",
        "type": "process",
        "command": "wt.exe",
        "windows": {
          "command": "wt.exe",
          "args": [
            "-d",
            "${workspaceFolder:.github (Org Governance)}",
            "powershell.exe",
            "-NoExit",
            "-Command",
            "agy --add-dir '${workspaceFolder:platform (Core Monorepo)}' --add-dir '${workspaceFolder:docs (Documentation Hub)}'",
          ],
        },
        "osx": {
          "command": "osascript",
          "args": [
            "-e",
            "tell application \"Terminal\" to do script \"cd '${workspaceFolder:.github (Org Governance)}' && agy --add-dir '${workspaceFolder:platform (Core Monorepo)}' --add-dir '${workspaceFolder:docs (Documentation Hub)}'\"",
          ],
        },
        "linux": {
          "command": "bash",
          "args": [
            "-c",
            "nohup x-terminal-emulator -e bash -c 'cd \"${workspaceFolder:.github (Org Governance)}\" && agy --add-dir \"${workspaceFolder:platform (Core Monorepo)}\" --add-dir \"${workspaceFolder:docs (Documentation Hub)}\"; exec bash' >/dev/null 2>&1 &",
          ],
        },
        "problemMatcher": [],
        "presentation": {
          "echo": false,
          "reveal": "never",
          "focus": false,
          "panel": "shared",
          "showReuseMessage": false,
          "close": true,
        },
      },
      {
        "label": "Admin CLI",
        "type": "process",
        "command": "powershell.exe",
        "windows": {
          "command": "powershell.exe",
          "args": [
            "-NoProfile",
            "-Command",
            "Start-Process wt.exe -Verb RunAs -ArgumentList @('-d', '${workspaceFolder:.github (Org Governance)}\\..')",
          ],
        },
        "osx": {
          "command": "osascript",
          "args": [
            "-e",
            "tell application \"Terminal\" to do script \"cd '${workspaceFolder:.github (Org Governance)}/..' && sudo -s\"",
          ],
        },
        "linux": {
          "command": "bash",
          "args": ["-c", "clear; echo 'Admin shell ready.'; sudo -s"],
          "presentation": {
            "reveal": "always",
            "panel": "new",
          },
        },
        "problemMatcher": [],
        "presentation": {
          "echo": false,
          "reveal": "never",
          "focus": false,
          "panel": "shared",
          "showReuseMessage": false,
          "close": true,
        },
      },
    ],
  },
}
